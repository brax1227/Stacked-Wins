# Database (PostgreSQL)
#
# Recommended (unix socket; works well with peer auth on Linux):
# Prisma requires a host in the authority section, but can be forced to use
# the local socket via `host=/var/run/postgresql`.
# DATABASE_URL="postgresql://USER@localhost:5432/stacked_wins?host=/var/run/postgresql&schema=public"
#
# Alternative (TCP; requires password/auth configured in pg_hba.conf):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stacked_wins?schema=public"
#
DATABASE_URL="postgresql://USER@localhost:5432/stacked_wins?host=/var/run/postgresql&schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Anthropic API — powers the "Too big" split assist, and the (deferred)
# plan generation and coach chat. Optional: without it the server still boots
# and the whole stack works, the AI suggestion button just doesn't appear.
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Logging
LOG_LEVEL=info
